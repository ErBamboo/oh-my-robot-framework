{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "om_layout.schema.json",
  "title": "OM boot layout source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "board",
    "device",
    "flash",
    "payloadOffset",
    "metaCopies",
    "rollbackLimit",
    "partitions"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "board": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "flash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "size", "eraseRegions"],
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "eraseRegions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offset", "size", "count"],
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "payloadOffset": {
      "type": "integer",
      "minimum": 512,
      "multipleOf": 512
    },
    "metaCopies": {
      "const": 2
    },
    "rollbackLimit": {
      "type": "integer",
      "minimum": 1
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "offset", "size", "role"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": ["bootloader", "app", "meta", "meta_resv"]
          },
          "slot": {
            "enum": ["a", "b"]
          },
          "description": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["role"],
              "properties": {
                "role": {
                  "const": "app"
                }
              }
            },
            "then": {
              "required": ["slot"]
            }
          }
        ]
      }
    },
    "reserved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["offset", "size"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
